<?xml version="1.0" encoding="utf-8"?>
<!-- Thin ring hugging the outside edge of dock tiles (HomeActivity insets it by -1dp), so banners close
     to the band's grey stand out. Radius = tile radius 14dp + 0.5dp to the stroke centre: concentric. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14.5dp" />
    <solid android:color="#00000000" />
    <stroke android:width="1dp" android:color="#4DFFFFFF" />
</shape>
